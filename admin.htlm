<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width">
<title>Admin GaragePro</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>body{font-family:sans-serif;padding:15px;background:#f5f5f5}
.stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.stat{background:white;padding:15px;border-radius:10px;text-align:center}
.stat b{font-size:24px;display:block;color:#16a34a}
table{width:100%;border-collapse:collapse;background:white;border-radius:10px}
th,td{padding:12px 8px;border-bottom:1px solid #eee}
th{background:#16a34a;color:white}
.premium{color:green;font-weight:bold;background:#dcfce7;padding:4px 8px;border-radius:20px}
.gratuit{color:#d97706;background:#fef3c7;padding:4px 8px;border-radius:20px}
</style></head><body>
<h1>📊 GaragePro Admin</h1>
<div class="stats">
<div class="stat"><b id="total">0</b>Garages</div>
<div class="stat"><b id="premium">0</b>Payés</div>
<div class="stat"><b id="revenu">0F</b>Revenu</div>
</div>
<table><thead><tr><th>Garage</th><th>Tel</th><th>Véh</th><th>Statut</th><th>Date</th></tr></thead>
<tbody id="list"><tr><td colspan="5">Chargement...</td></tr></tbody></table>
<script>
const SUPABASE_URL = 'https://fzoukuaadwvnnppkiqkf.supabase.co';
const SUPABASE_KEY = 'sb_publishable_JKJdHn9ciVp2Rh8Fbr62Hg_Neh8uNGL';
const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
async function load(){
  const {data}=await supabaseClient.from('garages').select('*').order('created_at',{ascending:false});
  if(!data||data.length==0){document.getElementById('list').innerHTML='<tr><td colspan=5>Aucun client. Partage ton lien</td></tr>';return;}
  document.getElementById('total').innerText=data.length;
  const premiums=data.filter(g=>g.is_premium).length;
  document.getElementById('premium').innerText=premiums;
  document.getElementById('revenu').innerText=(premiums*5000)+'F';
  document.getElementById('list').innerHTML=data.map(g=>`<tr><td>${g.nom_garage}</td><td>${g.telephone}</td><td>${g.nombre_vehicules}</td><td><span class="${g.is_premium?'premium':'gratuit'}">${g.is_premium?'PREMIUM':'GRATUIT'}</span></td><td>${new Date(g.created_at).toLocaleDateString()}</td></tr>`).join('');
} load();
</script></body></html>